{
  "name": "iChecker",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run scripts/patch-sharp.ts && bun run --watch 01-app/index.ts",
    "build_server": "bun run scripts/patch-sharp.ts && bun build \\\n\t--compile \\\n\t--minify-whitespace \\\n\t--minify-syntax \\\n\t--target bun \\\n\t--outfile server \\\n\t./01-app/index.ts",
    "start": "./server",
    "db:create": "bun run scripts/db-create.ts",
    "migrate": "bun run scripts/migrate.ts up",
    "migrate:status": "bun run scripts/migrate.ts status",
    "migrate:mark": "bun run scripts/migrate.ts mark --all",
    "backup": "bun run scripts/backup.ts",
    "restore": "bun run scripts/restore.ts",
    "pack": "bun run scripts/pack.ts",
    "unpack": "bun run scripts/unpack.ts",
    "test": "bun run scripts/patch-sharp.ts && bun test",
    "lint": "oxlint"
  },
  "dependencies": {
    "bunsql-native-migrate": "0.6.2",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "telegraf": "4.16.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "oxlint": "1.91.0"
  },
  "imports": {
    "#libvips": "./native-stage/libvips-cpp.so.8.18.6"
  },
  "module": true,
  "patchedDependencies": {
    "telegraf@4.16.3": "patches/telegraf@4.16.3.patch"
  }
}